{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "typeRoots": ["./.types/@types", "./node_modules/@types"], "types": ["node"],
    "paths": {
      "@earendil-works/pi-coding-agent": ["./.types/pi-coding-agent/dist/index.d.ts"],
      "@earendil-works/pi-ai": ["./.types/pi-ai/dist/index.d.ts"],
      "typebox": ["./.types/typebox/build/index.d.mts"]
    }
  },
  "include": ["*.ts"]
}
